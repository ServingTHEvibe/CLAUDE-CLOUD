# Copy to .env.local for local testing, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Nothing is hard-coded: leave a channel blank and it is simply off.

# --- Where order requests go (configure at least one) ---
# Email via Resend (https://resend.com). ORDER_EMAIL may be a comma-separated list.
RESEND_API_KEY=
ORDER_EMAIL=
# A sender on a domain verified in Resend, e.g. "Taylor Made Goodies <orders@yourdomain.com>"
ORDER_FROM_EMAIL=
# Also email the customer a copy of their request (true/false)
ORDER_CONFIRM_CUSTOMER=false

# SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ORDER_SMS_NUMBER=

# Webhook: Zapier / Make / Slack / Airtable / Square automation etc.
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_SECRET=
ORDER_WEBHOOK_INCLUDE_IMAGES=false

# --- Public contact info shown on the site (optional) ---
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
PUBLIC_INSTAGRAM_URL=
